{
	"name": "plought",
	"version": "3.0.0",
	"type": "module",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": "^22.17.0 || ^24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:format": "prettier --check .",
		"check": "npm run check:svelte && npm run knip && npm run check:format",
		"format": "prettier --write .",
		"knip": "knip",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"knip": "^6.41.0",
		"oxlint": "^1.88.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte-check": "^4.7.6",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@lucide/svelte": "^1.56.0",
		"@sveltejs/kit": "^3.0.1",
		"@valibot/to-json-schema": "^1.8.0",
		"@vercel/analytics": "^2.0.1",
		"bits-ui": "^2.19.5",
		"js-yaml": "^5.4.3",
		"layerchart": "^2.8.0",
		"marked": "^18.1.1",
		"openai": "^7.32.0",
		"runed": "^0.37.1",
		"svelte": "^5.57.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.5.0"
	},
	"overrides": {
		"@vercel/analytics": {
			"@sveltejs/kit": "$@sveltejs/kit"
		},
		"runed": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	}
}
